# Discord bot token (https://discord.com/developers/applications)
# Enable the "Message Content" privileged intent for the bot.
DISCORD_TOKEN=replace-with-your-discord-bot-token

# GeoGuessr session cookie from a dedicated account.
NCFA=replace-with-your-geoguessr-ncfa-cookie

# API key from https://www.bigdatacloud.com/ for reverse geocoding.
BIGDATACLOUD_API_KEY=replace-with-your-bigdatacloud-api-key

# Comma-separated Discord channel IDs where the bot is allowed to play.
ALLOWED_CHANNEL_IDS=replace-with-your-discord-channel-id

# Persistent SQLite database path. On Railway with a /data volume, use /data/streaks.db.
DB_PATH=streaks.db
